          },
          "pos_y": {
            "type": "number",
            "title": "Pos Y",
            "description": "Local ENU North position, meters."
          },
          "pos_z": {
            "type": "number",
            "title": "Pos Z",
            "description": "Local ENU Up position, meters."
          },
          "velocity": {
            "type": "number",
            "title": "Velocity",
            "description": "Speed, m/s."
          },
          "orientation": {
            "type": "number",
            "title": "Orientation",
            "description": "Heading, degrees, 0-360, 0=North."
          }
        },
        "type": "object",
        "required": [
          "t",
          "timestamp",
          "pos_x",
          "pos_y",
          "pos_z",
          "velocity",
          "orientation"
        ],
        "title": "TrajectoryPoint"
      },
      "TrajectoryResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "mock",
              "physics-baseline",
              "physics-baseline+ml-residual"
            ],
            "title": "Source"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/TrajectoryPoint"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "source",
          "generated_at",
          "points"
        ],
        "title": "TrajectoryResponse"
      },
      "UncertaintyBucket": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "description": "e.g. '0-30s', '30-90s', '90s+'."
          },
          "lo_s": {
            "type": "number",
            "title": "Lo S"
          },
