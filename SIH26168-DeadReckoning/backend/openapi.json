            "description": "null means unbounded (the last bucket)."
          },
          "radius_m": {
            "type": "number",
            "title": "Radius M",
            "description": "CEP-`coverage` confidence radius for this blackout-duration bucket."
          }
        },
        "type": "object",
        "required": [
          "label",
          "lo_s",
          "radius_m"
        ],
        "title": "UncertaintyBucket"
      },
      "UncertaintyPoint": {
        "properties": {
          "t": {
            "type": "number",
            "title": "T",
            "description": "Seconds elapsed since trace start."
          },
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          },
          "blackout_duration_s": {
            "type": "number",
            "title": "Blackout Duration S",
            "description": "Seconds since the most recent GNSS fix at or before t (or since trace start, if none yet)."
