# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Data (raw traces / public datasets are large — track via README + manifest, not git)
data/raw_traces/*
!data/raw_traces/README.md
data/public_datasets/*
!data/public_datasets/README.md

# ML artifacts
ml-residual/models/*.pkl
ml-residual/models/*.txt

# Backend DB (regenerated by ingest; not source of truth)
backend/data/*.duckdb
backend/data/*.duckdb.wal

# Node / frontend
node_modules/
dist/
build/

# Android
frontend-android/.gradle/
frontend-android/local.properties
frontend-android/*.apk

# OS / editor
.DS_Store
.vscode/
.idea/
*.log
